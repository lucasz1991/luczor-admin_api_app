{
    "name": "luczor/admin-api-app",
    "type": "project",
    "description": "Luczor Admin API and sync archive backend.",
    "keywords": ["luczor", "laravel", "api"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.15.3",
        "laravel/framework": "^12.61.1",
        "laravel/horizon": "^5.48.3",
        "laravel/jetstream": "^5.5.3",
        "laravel/reverb": "^1.11.1",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.30.0",
        "laravel/tinker": "^3.0.2",
        "livewire/livewire": "^3.8.2",
        "plesk/ext-laravel-integration": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23.1",
        "larastan/larastan": "^3.10.0",
        "laravel/pint": "^1.29.3",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^11.5.56",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G --no-progress",
        "format:check": "pint --test",
        "security:audit": "composer audit --locked",
        "test": "@php artisan test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
