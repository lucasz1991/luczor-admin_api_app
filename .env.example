APP_NAME="Luczor Admin API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luczor_admin_api
DB_USERNAME=root
DB_PASSWORD=
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=luczor_admin_api
LEGACY_MYSQL_USERNAME=root
LEGACY_MYSQL_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@luczor.local"
MAIL_FROM_NAME="${APP_NAME}"

LUCZOR_API_PREFIX=/api/v1
LUCZOR_ALLOW_REGISTRATION=true
LUCZOR_DEFAULT_MODEL_PROFILE=chat-fast
LUCZOR_PROXY_CONNECT_TIMEOUT=10
LUCZOR_PROXY_TIMEOUT=90
LUCZOR_PROXY_MAX_OUTPUT_TOKENS=8192
LUCZOR_PROXY_MAX_INPUT_TOKENS=24000
LUCZOR_PROXY_REQUESTS_PER_MINUTE=60
LUCZOR_JOB_PRIVATE_KEY_FILE=/run/secrets/luczor_job_private_key
LUCZOR_JOB_TTL_MINUTES=15
# JSON generated by `php artisan luczor:voice-release`; no end-user voice paths or keys.
LUCZOR_VOICE_MANIFEST_JSON=
REVERB_APP_ID=luczor
REVERB_APP_KEY=replace-with-public-reverb-key
REVERB_APP_SECRET=replace-with-reverb-secret
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
LUCZOR_REVERB_PUBLIC_HOST=localhost
LUCZOR_REVERB_PUBLIC_PORT=443
LUCZOR_REVERB_PUBLIC_SCHEME=https
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Cognee memory engine (server-side). Leave COGNEE_BASE_URL empty to disable.
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TIMEOUT=15

VITE_APP_NAME="${APP_NAME}"
