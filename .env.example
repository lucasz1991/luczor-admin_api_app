APP_NAME="Luczor Admin API"
APP_ENV=local
APP_KEY=
# Generate once as an independent 32+ byte secret; never reuse or rotate APP_KEY here.
LUCZOR_MEMORY_NAMESPACE_KEY=replace-with-stable-32-byte-memory-secret
# Independent, non-rotating HMAC key for durable write/Forget ledger identities.
LUCZOR_MEMORY_LEDGER_KEY=replace-with-stable-32-byte-ledger-secret
# On rotation, retain prior keys comma-separated until all old aliases are retired.
LUCZOR_MEMORY_PREVIOUS_NAMESPACE_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luczor_admin_api
DB_USERNAME=root
DB_PASSWORD=
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3306
LEGACY_MYSQL_DATABASE=luczor_admin_api
LEGACY_MYSQL_USERNAME=root
LEGACY_MYSQL_PASSWORD=

# Local-safe default. Production push requires BROADCAST_DRIVER=reverb.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Local-safe default. Production should use redis (or database) plus a persistent queue worker.
QUEUE_CONNECTION=sync
HORIZON_QUEUES=notifications,default
HORIZON_TRIES=4
HORIZON_TIMEOUT=90
HORIZON_NOTIFICATION_WAIT_SECONDS=30
HORIZON_FAST_TERMINATION=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
# If unset, secure cookies are inferred from an HTTPS APP_URL.
# SESSION_SECURE_COOKIE=false

# Explicit browser/WebView origins. Production has no wildcard fallback.
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CORS_ALLOWED_ORIGIN_PATTERNS=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@luczor.local"
MAIL_FROM_NAME="${APP_NAME}"

LUCZOR_API_PREFIX=/api/v1
LUCZOR_ALLOW_REGISTRATION=true
LUCZOR_DEFAULT_MODEL_PROFILE=chat-fast
LUCZOR_PROXY_CONNECT_TIMEOUT=10
LUCZOR_PROXY_TIMEOUT=90
LUCZOR_PROXY_MAX_OUTPUT_TOKENS=8192
LUCZOR_PROXY_MAX_INPUT_TOKENS=24000
LUCZOR_PROXY_REQUESTS_PER_MINUTE=60
# Incremental proxy I/O limits. The container edge and PHP-FPM also cap
# inbound bodies at 16 MiB; raising this value alone cannot bypass that edge.
LUCZOR_PROXY_MAX_REQUEST_BYTES=16777216
LUCZOR_PROXY_MAX_RESPONSE_BYTES=16777216
LUCZOR_PROXY_MAX_STREAM_BYTES=67108864
LUCZOR_PROXY_MAX_STREAM_FRAME_BYTES=1048576
LUCZOR_JOB_PRIVATE_KEY_FILE=/run/secrets/luczor_job_private_key
LUCZOR_JOB_TTL_MINUTES=15
# JSON generated by `php artisan luczor:voice-release`; no end-user voice paths or keys.
LUCZOR_VOICE_MANIFEST_JSON=
# Preferred production configuration: signed release envelope generated by the bootstrap script.
LUCZOR_VOICE_MANIFEST_FILE=
REVERB_APP_ID=luczor
REVERB_APP_KEY=replace-with-public-reverb-key
REVERB_APP_SECRET=replace-with-reverb-secret
# Set this to the deployed admin URL and the packaged Tauri WebView origin.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1,tauri.localhost
# Internal listener behind the Plesk WebSocket reverse proxy.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Public HTTPS/WSS endpoint used by Laravel when broadcasting.
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
LUCZOR_REVERB_PUBLIC_HOST=localhost
LUCZOR_REVERB_PUBLIC_PORT=443
LUCZOR_REVERB_PUBLIC_SCHEME=https
LUCZOR_NOTIFICATION_QUEUE=notifications
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Cognee memory engine (server-side). Leave COGNEE_BASE_URL empty to disable.
COGNEE_BASE_URL=
COGNEE_API_KEY=
COGNEE_TIMEOUT=45
COGNEE_CONTROL_TIMEOUT=8
COGNEE_ACK_TIMEOUT=3
COGNEE_SEMANTIC_QUERY_TIMEOUT=3
COGNEE_CONTENT_LOCK_SECONDS=120
COGNEE_CONTENT_SNAPSHOT_TTL_SECONDS=3600
# Experimental with pinned Cognee 1.4; enable only after the documented live timeout test.
COGNEE_IMPROVE_ENABLED=false
COGNEE_IMPROVE_MIN_INTERVAL_SECONDS=3600

VITE_APP_NAME="${APP_NAME}"
